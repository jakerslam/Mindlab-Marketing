<script is:inline>
  (() => {
    const key = 'mindlab-theme-v1';
    const root = document.documentElement;
    const system = window.matchMedia('(prefers-color-scheme: dark)');
    const valid = (value) => ['light', 'system', 'dark'].includes(value);
    const read = () => {
      try {
        const saved = localStorage.getItem(key);
        return valid(saved) ? saved : 'system';
      } catch { return 'system'; }
    };
    let preference = read();
    const apply = () => {
      const theme = preference === 'system' ? (system.matches ? 'dark' : 'light') : preference;
      root.dataset.theme = theme;
      root.dataset.themePreference = preference;
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.content = theme === 'dark' ? '#14151a' : '#f7f7f4';
      document.querySelectorAll('[data-theme-option]').forEach((input) => {
        input.checked = input.value === preference;
      });
      document.querySelectorAll('[data-theme-switch]').forEach((control) => { control.hidden = false; });
      document.dispatchEvent(new CustomEvent('mindlab:themechange', { detail: { theme } }));
    };
    // Runs in the head before the page paints; no stored preference means System.
    apply();
    document.addEventListener('DOMContentLoaded', apply, { once: true });
    document.addEventListener('change', (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || !input.matches('[data-theme-option]') || !valid(input.value)) return;
      preference = input.value;
      try { localStorage.setItem(key, preference); } catch { /* This page still honors the choice. */ }
      apply();
    });
    system.addEventListener('change', () => { if (preference === 'system') apply(); });
    window.addEventListener('storage', (event) => {
      if (event.key !== key && event.key !== null) return;
      preference = read();
      apply();
    });
  })();
</script>
