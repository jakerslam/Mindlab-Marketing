---
import type { Package, Project } from '@/domain/content';
import { withBase } from '@/lib/urls';
import Arrow from './Arrow.astro';
interface Props { project?: Project; service: Package['id'] }
const { project, service } = Astro.props;
const artifactId = service === 'brand-blueprint' ? 'message-map' : service === 'content-studio' ? 'sample-post' : 'ad-copy';
const artifact = project?.artifacts.find((item) => item.id === artifactId);
const excerpt = artifact?.items[service === 'brand-blueprint' ? 1 : 0];
---
{project && excerpt && <aside class="service-sample"><p class="eyebrow">A sample of the work / fictional brand</p><p class="service-sample-brand">{project.visual === 'northline' ? 'Northline Advisory' : 'Daybreak Studio'}</p><blockquote><p>{excerpt.title}</p><p>{excerpt.body}</p></blockquote><a class="text-link" href={withBase(`/work/${project.slug}/#${artifactId}`)}>Explore the demonstration<Arrow/></a></aside>}
