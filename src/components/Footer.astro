---
import { withBase } from '@/lib/urls';
import Mark from './Mark.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { integrations } from '@/integrations/config';
import { projectConfig } from '@/integrations/project';

const socialIcons: Record<typeof projectConfig.socialProfiles[number]['name'], string> = {
  LinkedIn: 'M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2ZM8.5 18h-3V9.5h3V18ZM7 8.4a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2ZM18.5 18h-3v-4.4c0-1.2-.4-1.8-1.3-1.8-1 0-1.7.7-1.7 1.8V18h-3V9.5h2.9v1.1a3.3 3.3 0 0 1 2.7-1.4c2.2 0 3.4 1.3 3.4 3.8V18Z',
  Instagram: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.4-3.3a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z',
  Facebook: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.8l-.5 2.9h-2.3v7A10 10 0 0 0 22 12Z',
};
---
<footer class="site-footer" id="site-footer">
  <div class="container">
    <div class="footer-main">
      <div>
        <a class="wordmark" href={withBase("/")}><Mark/><span>mindlab.</span></a>
        <p>Clear thinking.<br/> Connected marketing.</p>
        <ul class="footer-socials" aria-label="Social profiles" role="list">
          {projectConfig.socialProfiles.map(({ name, url }) => {
            const Profile = url ? 'a' : 'span';
            return (
              <li>
                <Profile class="footer-social" href={url || undefined}>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={socialIcons[name]} fill-rule="evenodd"/>
                  </svg>
                  <span class="visually-hidden">{name}{url ? '' : ' (coming soon)'}</span>
                </Profile>
              </li>
            );
          })}
        </ul>
      </div>
      <div><span class="footer-label">Explore</span><a href={withBase("/services/")}>Our services</a><a href={withBase("/pricing/")}>Packages & pricing</a><a href={withBase("/industries/")}>Industries</a></div>
      <div><span class="footer-label">Meet Mindlab</span><a href={withBase("/about/")}>About Mindlab</a><a href={withBase("/book-call/")}>Let’s talk</a></div>
      <div class="footer-note"><span class="footer-label">A good place to start</span><p>One business. One clear next step.<br/> Let’s work out yours.</p>{integrations.contactEmail && <a href={`mailto:${integrations.contactEmail}`}>{integrations.contactEmail}</a>}</div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Mindlab LLC</span>
      <ThemeSwitch/>
      <div>
        <a href={withBase("/privacy/")}>Privacy &amp; Cookies</a>
        <a href={withBase("/terms/")}>Terms of Use</a>
        <a href={withBase("/ai-use/")}>How We Use AI</a>
        {integrations.analytics && <button class="text-button" type="button" data-consent-open>Cookie preferences</button>}
        <span>Built with intention.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 8px 0 0 -7px;
    padding: 0;
    list-style: none;
  }
  .footer-social {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
  }
  span.footer-social {
    color: #a3a2ae;
  }
</style>
