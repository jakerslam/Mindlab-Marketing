---
import type { Guide } from '@/domain/content';
import { withBase } from '@/lib/urls';
import Arrow from './Arrow.astro';
interface Props { guides: Guide[]; headingLevel?: 2 | 3 }
const { guides, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---
<div class="guide-list">{guides.map((guide, index) => <article><span class="mono">0{index + 1} / {guide.category}</span><div><Heading><a href={withBase(`/thinking/${guide.slug}/`)}>{guide.title}<Arrow/></a></Heading><p>{guide.summary}</p></div></article>)}</div>
