---
import { withBase } from '@/lib/urls';
import { hasOptionalAnalytics, integrations, zoomInfoProjectKey } from '@/integrations/config';
const analytics = integrations.analytics;
---
  <div class="consent-banner" id="consent-banner" role="region" aria-labelledby="consent-title" hidden data-gtm-id={analytics?.id} data-zoominfo-key={zoomInfoProjectKey}>
    <div>
      <strong id="consent-title">Cookies and privacy</strong>
      <p>
        {hasOptionalAnalytics
          ? 'Optional analytics help us understand how the site is used and which businesses visit. We only load them if you agree.'
          : 'We use browser storage to remember your preferences. Our booking and inquiry tools may use their own cookies.'}
        <a href={withBase("/privacy/#cookies")}>Privacy &amp; Cookies</a>
      </p>
    </div>
    <div class="consent-actions">
      {hasOptionalAnalytics ? <>
        <button class="button button-outline button-small" type="button" data-consent="denied">Reject analytics</button>
        <button class="button button-small" type="button" data-consent="granted">Allow analytics</button>
      </> : <>
        <button class="button button-outline button-small" type="button" data-cookie-notice-dismiss>Deny</button>
        <button class="button button-small" type="button" data-cookie-notice-dismiss>Got it</button>
      </>}
    </div>
  </div>
  {hasOptionalAnalytics ? <script>
    type DataWindow = Window & { ZIProjectKey?: string; dataLayer?: Record<string, unknown>[] };
    const w = window as DataWindow;
    const banner = document.getElementById('consent-banner');
    const key = banner?.dataset.zoominfoKey ? 'mindlab-analytics-v2' : 'mindlab-analytics-v1';
    let active = false;
    let preference: string | null = null;
    try { preference = localStorage.getItem(key); } catch { /* Storage may be disabled. */ }
    const load = () => {
      if (active || !banner) return;
      active = true;
      if (banner.dataset.zoominfoKey) {
        w.ZIProjectKey = banner.dataset.zoominfoKey;
        const zoomInfo = document.createElement('script');
        zoomInfo.async = true;
        zoomInfo.src = 'https://js.zi-scripts.com/zi-tag.js';
        document.head.append(zoomInfo);
      }
      if (!banner.dataset.gtmId) return;
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtm.js?id=${banner.dataset.gtmId}`;
      document.head.append(script);
    };
    if (preference === 'granted') load();
    if (!preference && banner) banner.hidden = false;
    banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => button.addEventListener('click', () => {
      const selected = button.dataset.consent!;
      try { localStorage.setItem(key, selected); } catch { /* Current-page choice still works. */ }
      if (banner) banner.hidden = true;
      if (selected === 'granted') { preference = selected; load(); }
      else { const previouslyActive = active; preference = selected; if (previouslyActive) window.location.reload(); }
    }));
    document.querySelector('[data-consent-open]')?.addEventListener('click', () => { if (banner) banner.hidden = false; });
    // Strict allowlist. Never send form values, query strings, or contact data.
    document.addEventListener('click', (event) => {
      if (!active || preference !== 'granted' || !(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLElement>('[data-track]');
      if (!link) return;
      const allowed = ['strategy_call_click', 'package_interest', 'booking_link_opened'];
      const name = link.dataset.track;
      if (name && allowed.includes(name)) w.dataLayer?.push({ event: name, location: link.dataset.location || 'page', service: link.dataset.service || 'unspecified' });
    });
  </script> : <script is:inline>
    (() => {
      const banner = document.getElementById('consent-banner');
      if (!banner) return;
      const key = 'mindlab-cookie-notice-v1';
      let dismissed = false;
      try { dismissed = localStorage.getItem(key) === 'dismissed'; } catch { /* Storage may be disabled. */ }
      banner.hidden = dismissed;
      banner.querySelectorAll('[data-cookie-notice-dismiss]').forEach((button) => button.addEventListener('click', () => {
        banner.hidden = true;
        try { localStorage.setItem(key, 'dismissed'); } catch { /* Dismissal still works on this page. */ }
      }));
    })();
  </script>}
