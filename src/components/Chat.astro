<button type="button" class="button button-small chat-launcher" id="chat-launcher" hidden>Chat with Mindlab</button>

<script is:inline>
  (() => {
    const launcher = document.getElementById('chat-launcher');
    if (!launcher) return;
    launcher.hidden = false;
    launcher.addEventListener('click', () => {
      launcher.disabled = true;
      launcher.textContent = 'Opening chat…';
      window.Tawk_API = window.Tawk_API || {};
      window.Tawk_LoadStart = new Date();
      window.Tawk_API.onLoad = () => {
        window.Tawk_API.maximize();
        launcher.hidden = true;
      };

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://embed.tawk.to/6af2467f4a415d3c430e8ee8/1k7166os7';
      script.crossOrigin = 'anonymous';
      script.addEventListener('error', () => {
        script.remove();
        launcher.textContent = 'Retry chat';
        launcher.disabled = false;
      });
      document.head.append(script);
    });
  })();
</script>

<style>
  .chat-launcher {
    position: fixed;
    right: 18px;
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 40;
  }

  .chat-launcher[hidden],
  :global(body:has(#consent-banner:not([hidden]))) .chat-launcher {
    display: none;
  }
</style>
