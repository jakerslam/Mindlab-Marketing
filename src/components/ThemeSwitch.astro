<fieldset class="theme-switch" data-theme-switch hidden>
  <legend class="visually-hidden">Color theme</legend>
  <div class="theme-options">
    <label><input type="radio" name="color-theme" value="light" data-theme-option/><span>Light</span></label>
    <label><input type="radio" name="color-theme" value="system" data-theme-option checked/><span>System</span></label>
    <label><input type="radio" name="color-theme" value="dark" data-theme-option/><span>Dark</span></label>
  </div>
</fieldset>
