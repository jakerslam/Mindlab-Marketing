---
import Layout from '@/layouts/Layout.astro';
import CTA from '@/components/CTA.astro';
import Arrow from '@/components/Arrow.astro';
import { getContent } from '@/content';
const { industries } = await getContent();
const audiences = [
  { id: 'b2b', label: 'Business to business', title: 'Make complex value clear.', description: 'Help buyers understand your expertise, weigh their options, and see why your offer fits. Useful content and focused campaigns start with a well-defined buyer.' },
  { id: 'b2c', label: 'Business to consumer', title: 'Connect the offer to everyday life.', description: 'Give people a reason to care and a clear next step. Bring the customer’s need, the message, and the campaign into the same conversation.' },
];
---
<Layout title="Marketing for B2B & B2C businesses" description="Brand strategy, content, and campaign applications for professional services, IT, recruiting, home services, lifestyle, and consumer businesses.">
  <section class="page-hero container"><p class="eyebrow">Who we help</p><h1>Your audience.<br/>Our starting point.</h1><p class="lede">A business buyer and a local customer make different decisions. We shape the message around the people you want to reach, using the same three core services.</p><div class="anchor-nav"><a href="#b2b">B2B businesses<span>↘</span></a><a href="#b2c">B2C businesses<span>↘</span></a></div><p class="section-note">These are areas of service focus and examples of application, rather than claims of past client experience.</p></section>
  {audiences.map((audience) => <section class:list={['section', { tinted: audience.id === 'b2c' }]} id={audience.id}><div class="container"><div class="section-heading"><div><p class="eyebrow">{audience.label}</p><h2>{audience.title}</h2></div><p>{audience.description}</p></div><div class="industry-details">{industries.filter((industry) => industry.audience === audience.id).map((industry) => <article id={industry.id}><div><h3>{industry.name}</h3><span>{industry.examples}</span></div><div><p class="industry-challenge">{industry.challenge}</p><p>{industry.approach}</p><p class="industry-action"><span>Possible next step</span>{industry.action}</p></div><a class="round-arrow" href="/book-call/" aria-label={`Discuss marketing for ${industry.name}`}><Arrow/></a></article>)}</div></div></section>)}
  <CTA title="Let’s put your business in the picture."/>
</Layout>
