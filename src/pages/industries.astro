---
import { withBase } from '@/lib/urls';
import Layout from '@/layouts/Layout.astro';
import CTA from '@/components/CTA.astro';
import Arrow from '@/components/Arrow.astro';
import { getContent } from '@/content';
const { industries } = await getContent();
const audiences = [
  { id: 'b2b', label: 'Business to business', title: 'Help buyers understand your expertise.', description: 'Position a complex offer, turn expert knowledge into useful content, and support suitable business inquiries.' },
  { id: 'b2c', label: 'Business to consumer', title: 'Connect an offer to a customer’s next step.', description: 'Explain the experience, answer practical questions, and build a focused route to a booking, inquiry, or purchase.' },
];
const legacyDestinations = Object.fromEntries([
  ...audiences.map((audience) => [audience.id, withBase(`/industries/${audience.id}/`)]),
  ...industries.map((industry) => [industry.id, withBase(`/industries/${industry.audience}/#${industry.id}`)]),
]);
---
<Layout title="Who we help: B2B & B2C businesses" description="Explore Mindlab’s brand strategy, written content, and paid campaign approach for business buyers and consumer audiences.">
  <section class="page-hero container audience-overview-hero"><h1>Who we help.</h1><p class="lede">Business buyers and everyday customers need different reasons to act. Explore how the same three services apply to each audience.</p></section>
  <section class="section audience-overview"><div class="container audience-overview-grid">{audiences.map((audience) => <article class:list={['audience-overview-panel', `overview-${audience.id}`]} id={audience.id}><p class="eyebrow context-label">{audience.label}</p><h2>{audience.title}</h2><p>{audience.description}</p><a class="text-link" href={withBase(`/industries/${audience.id}/`)}>Explore {audience.id.toUpperCase()} marketing<Arrow/></a><ul>{industries.filter((industry) => industry.audience === audience.id).map((industry) => <li id={industry.id}><a href={withBase(`/industries/${industry.audience}/#${industry.id}`)}>{industry.name}<span aria-hidden="true">↗</span></a></li>)}</ul></article>)}</div></section>
  <section class="section audience-overview-next"><div class="container cta-inner"><div><h2>Strategy. Content. Campaigns.</h2><p>Choose a focused project or ongoing support. Every engagement starts with an agreed scope and the same published package fees.</p></div><a class="button button-outline" href={withBase('/pricing/')}>Compare packages & pricing<Arrow/></a></div></section>
  <CTA title="Let’s put your business in the picture." description="Tell us who you want to reach, what you offer, and the next step you want your marketing to support."/>
</Layout>
<script define:vars={{ legacyDestinations }}>
  const followLegacyAnchor = () => {
    const key = location.hash.slice(1);
    if (Object.hasOwn(legacyDestinations, key)) location.replace(legacyDestinations[key]);
  };
  followLegacyAnchor();
  window.addEventListener('hashchange', followLegacyAnchor);
</script>
