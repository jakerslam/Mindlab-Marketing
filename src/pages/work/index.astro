---
import Layout from '@/layouts/Layout.astro';
import WorkCards from '@/components/WorkCards.astro';
import { getContent } from '@/content';
const { projects } = await getContent();
---
<Layout title="Sample work" description="Explore Mindlab’s original marketing samples for fictional businesses.">
  <section class="page-hero container">
    <h1>Sample work.</h1>
    <p class="lede">Explore how we approach positioning, content, and advertising through original examples for fictional businesses.</p>
  </section>
  <section class="section work-section" aria-label="Sample projects">
    <div class="container"><WorkCards projects={projects} headingLevel={2}/></div>
  </section>
</Layout>
