---
import Layout from '@/layouts/Layout.astro';
import WorkCards from '@/components/WorkCards.astro';
import CTA from '@/components/CTA.astro';
import { getContent } from '@/content';
const { projects } = await getContent();
---
<Layout title="Our thinking, made tangible" description="Explore original sample concepts showing how Mindlab connects brand strategy, content, and paid campaign planning.">
  <section class="page-hero container"><p class="eyebrow">Our thinking</p><h1>From the business<br/>problem to the idea.</h1><p class="lede">See how we approach a brief, shape the message, and connect the work. These original demonstrations make the thinking tangible.</p><p class="sample-notice"><strong>Sample concepts, clearly labeled.</strong> The businesses below are fictional. These are demonstrations of our approach, with no client relationship or performance results claimed.</p></section>
  <section class="section section-compact"><div class="container"><WorkCards projects={projects} headingLevel={2}/></div></section>
  <CTA title="What could a clearer direction look like for you?"/>
</Layout>
