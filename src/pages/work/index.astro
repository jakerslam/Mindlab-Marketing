---
import Layout from '@/layouts/Layout.astro';
import { withBase } from '@/lib/urls';
const destination = withBase('/about/#our-thinking');
---
<Layout title="Our thinking has a new home" description="Find Mindlab’s sample work and practical guides on the About page." canonicalPath="/about/" noindex>
  <meta slot="head" http-equiv="refresh" content={`0;url=${destination}`}/>
  <section class="page-hero container"><h1>Our thinking,<br/>all in one place.</h1><p class="lede">Our sample work and practical guides are now part of About Mindlab.</p><a class="button" href={destination}>Explore our thinking →</a></section>
</Layout>
