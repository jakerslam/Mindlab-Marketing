---
import Layout from '@/layouts/Layout.astro';
import WorkVisual from '@/components/WorkVisual.astro';
import CTA from '@/components/CTA.astro';
import Arrow from '@/components/Arrow.astro';
import { getContent } from '@/content';
export async function getStaticPaths() {
  const { projects } = await getContent();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<Layout title={project.title} description={project.summary}>
  <section class="page-hero container"><a class="back-link" href="/work/">← All thinking</a><p class="eyebrow">{project.label} / {project.audience}</p><h1>{project.title}</h1><p class="lede">{project.summary}</p><div class="project-tags"><span>{project.service}</span><span>Original Mindlab demonstration</span></div></section>
  <div class="container project-showcase"><WorkVisual visual={project.visual}/></div>
  <section class="section"><div class="container project-story"><div><p class="eyebrow">The brief</p><h2>Start with<br/>the real question.</h2></div><div><p class="story-intro">{project.context}</p>{project.decisions.map((decision, index) => <article><span class="mono">0{index + 1} /</span><h3>{decision.title}</h3><p>{decision.body}</p></article>)}<div class="sample-notice"><strong>What this demonstrates</strong><p>{project.takeaway}</p></div><a class="text-link" href="/services/">Explore the services behind the thinking <Arrow/></a></div></div></section><CTA/>
</Layout>
