---
import { withBase } from '@/lib/urls';
import Layout from '@/layouts/Layout.astro';
import Arrow from '@/components/Arrow.astro';
import PackageRows from '@/components/PackageRows.astro';
import PackagePlanner from '@/components/PackagePlanner';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { getContent } from '@/content';
import { formatPrice } from '@/domain/content';

const { packages, faqs } = await getContent();
const retainers = packages.filter((pkg) => pkg.cadence === 'month');
const combinedPrice = retainers.reduce((total, pkg) => total + pkg.price, 0);
const combinedSetup = retainers.reduce((total, pkg) => total + pkg.setup, 0);
const plannerPackages = packages.map(({ id, name, price, setup, cadence }) => ({ id, name, price, setup, cadence }));
---
<Layout title="Packages & pricing" description="Compare Mindlab’s brand strategy, content, and paid campaign packages. See service fees, setup costs, included deliverables, and an interactive budget estimate.">
  <section class="page-hero container pricing-hero">
    <p class="eyebrow">Packages & pricing</p>
    <h1>Choose the support you need.</h1>
    <p class="lede">A focused strategy project or ongoing content and campaign support. Defined scope, with setup and advertising costs shown separately.</p>
  </section>

  <section class="pricing-overview" id="packages" aria-label="Service packages and fees">
    <div class="container">
      <PackageRows packages={packages}/>
      <div class="pricing-combined" id="combined">
        <div>
          <h2>Need content and campaigns?</h2>
          <p>Both monthly scopes, with a coordinated review. Brand Blueprint remains a separate project.</p>
        </div>
        <div>
          <p class="pricing-combined-amount">{formatPrice(combinedPrice)}<span> / month</span></p>
          <p>+ {formatPrice(combinedSetup)} one-time setup. Media additional.</p>
        </div>
        <a class="text-link" href={withBase('/book-call/?service=combined')} data-track="package_interest" data-service="combined">Discuss both <Arrow/></a>
      </div>
      <details class="budget-estimator" id="estimate">
        <summary><span>Estimate your first month</span><span class="estimator-plus" aria-hidden="true">+</span></summary>
        <div class="budget-estimator-body"><PackagePlanner packages={plannerPackages} client:visible/><noscript><p>JavaScript enables the interactive estimate. Service prices and setup fees are listed above.</p></noscript></div>
      </details>
      <p class="section-note pricing-note">All prices in USD. Advertising spend, taxes, and separately scoped production or technical work are additional. Final scope and terms are confirmed in your agreement.</p>
    </div>
  </section>

  <section class="section pricing-questions">
    <div class="container faq-grid">
      <div><p class="eyebrow">Before we begin</p><h2>A few pricing questions.</h2><a class="text-link" href={withBase('/services/')}>Explore the full service scope<Arrow/></a></div>
      <FAQ items={faqs.filter((_, index) => [1, 2, 3].includes(index))}/>
    </div>
  </section>
  <CTA/>
</Layout>
<script>
  const estimator = document.querySelector<HTMLDetailsElement>('#estimate');
  const openLinkedEstimator = () => { if (estimator && location.hash === '#estimate') estimator.open = true; };
  openLinkedEstimator();
  window.addEventListener('hashchange', openLinkedEstimator);
</script>
