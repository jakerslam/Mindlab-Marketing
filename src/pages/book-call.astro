---
import Layout from '@/layouts/Layout.astro';
import Arrow from '@/components/Arrow.astro';
import { integrations } from '@/integrations/config';
import { getContent } from '@/content';
import { formatPrice } from '@/domain/content';
const { packages } = await getContent();
const form = integrations.leadCapture;
const booking = integrations.booking;
const retainers = packages.filter((pkg) => pkg.cadence === 'month');
const combinedSummary = { id: 'combined', name: 'Content and Campaigns', price: `${formatPrice(retainers.reduce((total, pkg) => total + pkg.price, 0))} / month + ${formatPrice(retainers.reduce((total, pkg) => total + pkg.setup, 0))} setup. Media additional.` };
---
<Layout title="Let’s talk about your next step" description="Explore a 20-minute strategy call with Mindlab to discuss your goals, the work you need, and whether we're a good fit.">
  <section class="section container booking-grid"><div class="booking-copy"><p class="eyebrow">Start a conversation</p><h1>What’s your<br/>next chapter?</h1><p class="lede">A 20-minute conversation about your business, your goals, and the kind of support that could help.</p><ol class="booking-steps"><li><span>01</span><div><strong>Share a little context.</strong><p>Tell us what you offer and what you’re trying to solve.</p></div></li><li><span>02</span><div><strong>Talk through the priorities.</strong><p>We’ll discuss the offer, the audience, and where the work could start.</p></div></li><li><span>03</span><div><strong>Decide if there’s a fit.</strong><p>If there is, we can define the scope and next steps.</p></div></li></ol><p class="section-note">A fit conversation, with no obligation to proceed. No audit or written strategy is included in the call.</p>
    <div id="selected-package" class="selected-package" hidden><span class="eyebrow">You’re considering</span><strong id="selected-name"></strong><p id="selected-price"></p><a href="/services/#packages" class="text-link">Review all packages <Arrow/></a></div>
  </div><div class="booking-panel">
    {form ? <><h2>Tell us a little about your business.</h2><p>Share your goal using the inquiry form below.</p><div class="form-embed" id="inquiry-container" data-form-id={form.id}><iframe id="inquiry-frame" title="Mindlab business inquiry" src={`https://tally.so/embed/${form.id}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=0`} width="100%" height="720" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div><p class="form-note">Having trouble with the form? <a href={form.hostedUrl} target="_blank" rel="noopener noreferrer">Open it in a new tab ↗</a></p><p class="form-note">We use Tally to receive and store inquiries. <a href="/privacy/">How we handle your information</a>.</p></> : <div class="booking-pending"><span class="status-dot"></span><p class="eyebrow">A new chapter is taking shape</p><h2>{booking ? 'Ready to talk?' : 'Strategy calls are opening soon.'}</h2><p>{booking ? 'Choose an available time for a 20-minute conversation about your business and goals.' : 'We’re getting Mindlab ready for its first conversations. In the meantime, explore our services and the work we can help with.'}</p>{integrations.contactEmail && <a class="text-link" href={`mailto:${integrations.contactEmail}`}>Email {integrations.contactEmail}<Arrow/></a>}{!booking && <a class="button" href="/services/">Explore the packages <Arrow/></a>}</div>}
    {booking && <div class="booking-direct"><h3>{form ? 'Prefer to go straight to the conversation?' : 'Find a time that works for you.'}</h3><a class="button" href={booking.url} target="_blank" rel="noopener noreferrer" data-track="booking_link_opened" data-location="book-call">Choose a time <Arrow/></a><p class="form-note">Opens our booking calendar in a new tab.</p></div>}
  </div></section>
  <script define:vars={{ combinedSummary, packageSummaries: packages.map(({ id, name, price, setup, cadence }) => ({ id, name, price: `${formatPrice(price)} / ${cadence}${setup ? ` + ${formatPrice(setup)} one-time setup` : ''}${id === 'demand-campaigns' ? '. Media additional.' : ''}` })) }}>
    const service = new URLSearchParams(location.search).get('service');
    const options = [...packageSummaries, combinedSummary];
    const selected = options.find((item) => item.id === service);
    if (selected) {
      document.getElementById('selected-package').hidden = false;
      document.getElementById('selected-name').textContent = selected.name;
      document.getElementById('selected-price').textContent = selected.price;
      const frame = document.getElementById('inquiry-frame');
      if (frame) { const url = new URL(frame.src); url.searchParams.set('service', selected.id); frame.src = url.toString(); }
    }
  </script>
</Layout>
