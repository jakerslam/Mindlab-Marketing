---
import Layout from '@/layouts/Layout.astro';
import CTA from '@/components/CTA.astro';
import Arrow from '@/components/Arrow.astro';
import { withBase } from '@/lib/urls';
import { getContent } from '@/content';
const { projects, guides } = await getContent();
const disciplines = [
  ['01', 'Strategy', 'Choose what to say.', 'Positioning, message hierarchy, voice, and a plan for the next 90 days.', 'brand-blueprint'],
  ['02', 'Content', 'Make the message useful.', 'Expert-led written content built around the questions your customers ask.', 'content-studio'],
  ['03', 'Campaigns', 'Give the offer a focused route.', 'Paid ad management, copy variants, optimization, and review.', 'demand-campaigns'],
];
const briefQuestions = [
  ['The offer', 'What are we asking people to consider?'],
  ['The audience', 'Who needs it, and what matters to them?'],
  ['The next step', 'What should someone do after reading?'],
  ['The evidence', 'Which reasons to believe can we support?'],
  ['The constraints', 'What budget, inputs, and approvals shape the work?'],
  ['The review', 'What will we measure, and who will act on it?'],
];
---
<Layout title="About Mindlab: our approach & thinking" description="Meet Mindlab’s approach to brand strategy, content, and campaigns. Explore sample work, practical guides, and how we work together.">
  <section class="page-hero container firm-hero"><p class="eyebrow">About Mindlab</p><h1>One direction.<br/>From plan to campaign.</h1><div class="firm-introduction"><p class="lede">Mindlab brings brand strategy, written content, and paid advertising together around your business goals.</p><p>For B2B and B2C businesses, the starting point is the same: understand the offer, the audience, and the decision the marketing needs to support. Then give each piece of work a defined role.</p></div></section>
  <section class="section firm-disciplines"><div class="container"><div class="section-heading"><div><p class="eyebrow">Three connected disciplines</p><h2>A shared brief.<br/>Work with a purpose.</h2></div><p>Each service can stand on its own. When they work together, the positioning guides the writing and the offer guides the campaign.</p></div><div class="discipline-grid">{disciplines.map(([number, name, title, description, id]) => <article><span class="mono">{number} / {name}</span><h3>{title}</h3><p>{description}</p><a class="text-link" href={withBase(`/services/#${id}`)}>Explore {name.toLowerCase()}<Arrow/></a></article>)}</div></div></section>
  <section class="section about-thinking" id="our-thinking"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">Our thinking</p><h2>The approach,<br/>put into practice.</h2></div><p>Explore the writing and decisions behind two original demonstrations, or start with a practical guide.</p></div>
    <div class="about-example-grid" id="examples">{projects.map((project) => <article class:list={['about-example', `about-example-${project.visual}`]}><p class="eyebrow">{project.label} / {project.audience}</p><h3><a href={withBase(`/work/${project.slug}/`)}>{project.title}<Arrow/></a></h3><p>{project.summary}</p></article>)}</div>
    <p class="about-example-disclosure">Fictional businesses. Original demonstrations, with no client relationship or campaign results claimed.</p>
    {guides.length > 0 && <div class="about-guides" id="guides"><h3>Practical guides</h3><ul>{guides.map((guide) => <li><span class="mono">{guide.category}</span><a href={withBase(`/thinking/${guide.slug}/`)}>{guide.title}<Arrow/></a></li>)}</ul></div>}
    <details class="about-brief" id="brief"><summary>Six questions for a better brief<span aria-hidden="true">+</span></summary><ol>{briefQuestions.map(([title, question]) => <li><strong>{title}</strong><p>{question}</p></li>)}</ol></details>
  </div></section>
  <section class="section tinted"><div class="container"><div class="section-heading"><div><p class="eyebrow">What you can expect</p><h2>A practical<br/>working relationship.</h2></div><p>We agree the scope, your inputs, and the review process before starting. Your knowledge of the business shapes the brief and the work.</p></div><div class="values-grid">{[
    ['Scope before activity', 'Deliverables, fees, revisions, and exclusions are visible before the work begins. Your written agreement confirms the detail.'],
    ['Your business in the room', 'We need your knowledge, access, and timely feedback. You know the business; we help turn that understanding into marketing work.'],
    ['Ownership that stays with you', 'Your advertising accounts and data belong to your business. Deliverable ownership follows the agreement.'],
    ['An honest review of the work', 'We discuss what happened and what to try next. We do not guarantee a number of leads, sales, or revenue.'],
  ].map(([title, body], index) => <article><span class="mono">0{index + 1} /</span><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
  <CTA title="Let’s start with your next decision."/>
</Layout>
