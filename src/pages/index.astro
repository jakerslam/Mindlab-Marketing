---
import Layout from '@/layouts/Layout.astro';
import Arrow from '@/components/Arrow.astro';
import HeroArtwork from '@/components/HeroArtwork.astro';
import PackageCards from '@/components/PackageCards.astro';
import WorkCards from '@/components/WorkCards.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { getContent } from '@/content';
const content = await getContent();
---
<Layout title="Clear thinking. Connected marketing." description={content.settings.description}>
  <section class="hero"><div class="container hero-grid">
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span>{content.home.eyebrow}</p><h1>{content.home.title}</h1><p class="hero-description">{content.home.description}</p><div class="hero-actions"><a class="button" href="/book-call/" data-track="strategy_call_click" data-location="hero">Book a strategy call <Arrow/></a><a class="text-link" href="/services/#packages">Explore packages <Arrow/></a></div><p class="hero-footnote">Brand strategy · Content · Paid campaigns</p></div>
    <HeroArtwork/>
  </div></section>
  <div class="intro-strip"><div class="container"><span>Built around your business.</span><div><span>B2B & B2C</span><i></i><span>Clear deliverables</span><i></i><span>Connected thinking</span></div><span class="mono">A LITTLE CLARITY GOES A LONG WAY. ↘</span></div></div>

  <section class="section services-intro"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">The work we do</p><h2>Three disciplines.<br/>One clearer direction.</h2></div><p>A strong message, useful content, and the right reach. Choose the support you need, with a plan that connects the pieces.</p></div>
    <div class="service-rows">{content.packages.map((pkg) => <a class="service-row" href={`/services/#${pkg.id}`}><span class="mono service-number">{pkg.number}</span><div><h3>{pkg.name}</h3><span>{pkg.tagline}</span></div><p>{pkg.description}</p><span class="round-arrow"><Arrow/></span></a>)}</div>
  </div></section>

  <section class="section work-section"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">Thinking, made tangible</p><h2>See how the<br/>pieces come together.</h2></div><div><p>Two original sample concepts. A look at how we connect the business problem to the message and the next step.</p><a class="text-link" href="/work/">Explore our thinking <Arrow/></a></div></div>
    <WorkCards projects={content.projects}/>
  </div></section>

  <section class="section audience-section"><div class="container">
    <div class="audience-intro"><p class="eyebrow">Who we help</p><h2>Different businesses.<br/>The same need for clarity.</h2><p>Whether you’re explaining a complex service or making a consumer offer stand out, start with the people you want to reach.</p></div>
    <div class="audience-grid"><a href="/industries/#b2b" class="audience-panel"><span class="mono">01 / BUSINESS TO BUSINESS</span><h3>Make your<br/>expertise matter.</h3><p>Help business buyers understand your value, trust your thinking, and take the next step.</p><span class="text-link">Explore B2B <Arrow/></span></a><a href="/industries/#b2c" class="audience-panel"><span class="mono">02 / BUSINESS TO CONSUMER</span><h3>Give people<br/>a reason to choose.</h3><p>Connect your offer to an everyday need, with a clear story and a focused campaign.</p><span class="text-link">Explore B2C <Arrow/></span></a></div>
    <div class="industry-preview">{content.industries.map((industry) => <a href={`/industries/#${industry.id}`}>{industry.name}<Arrow/></a>)}</div>
  </div></section>

  <section class="section process-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">How we work</p><h2>Clear at every step.</h2></div><p>Know what we’re making, why it matters, and what comes next. No mystery between the brief and the work.</p></div><ol class="process-grid">{[
    ['Understand', 'Your business, your customers, your goals. We start by asking the right questions.'],
    ['Define', 'Agree the message, priorities, deliverables, and what a useful outcome looks like.'],
    ['Create & launch', 'Make the work, get your input, and put the agreed plan into motion.'],
    ['Review & improve', 'Look at what happened, share what we learned, and decide the next move.'],
  ].map(([title, body], i) => <li><span class="process-number">0{i + 1}<span>↗</span></span><h3>{title}</h3><p>{body}</p></li>)}</ol></div></section>

  <section class="section" id="packages"><div class="container"><div class="section-heading"><div><p class="eyebrow">A clear place to start</p><h2>Good work.<br/>Defined scope.</h2></div><div><p>Choose a focused project or ongoing support. Here’s what the work costs, before we talk.</p><a class="text-link" href="/services/#packages">All packages & details <Arrow/></a></div></div><PackageCards packages={content.packages}/><p class="section-note">Prices in USD. Setup fees and media costs shown separately. Final scope and terms confirmed in your agreement.</p></div></section>

  <section class="section approach-section"><div class="container approach-grid"><div class="approach-art" aria-hidden="true"><div></div><div></div><div></div><span>CLEAR THINKING.<br/>CONNECTED WORK.</span></div><div><p class="eyebrow">The Mindlab approach</p><h2>Thoughtful by design.<br/>Practical by nature.</h2><p>We believe a marketing plan should make your next decision easier. That means asking useful questions, being clear about the work, and keeping your business goal in view.</p><a class="text-link" href="/about/">Get to know our approach <Arrow/></a></div></div></section>

  <section class="section"><div class="container faq-grid"><div><p class="eyebrow">A few good questions</p><h2>Let’s clear<br/>things up.</h2></div><FAQ items={content.faqs}/></div></section>
  <CTA/>
</Layout>
