---
import { withBase } from '@/lib/urls';
import Layout from '@/layouts/Layout.astro';
import Arrow from '@/components/Arrow.astro';
import HeroArtwork from '@/components/HeroArtwork.astro';
import WorkCards from '@/components/WorkCards.astro';
import GuideList from '@/components/GuideList.astro';
import { serviceDetails } from '@/domain/services';
import { integrations } from '@/integrations/config';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { getContent } from '@/content';
const content = await getContent();
const siteUrl = new URL(withBase('/'), Astro.site).href;
const organizationId = `${siteUrl}#organization`;
const searchMetadata = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Mindlab Solutions',
      legalName: 'Mindlab LLC',
      url: siteUrl,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Mindlab Solutions',
      url: siteUrl,
      publisher: { '@id': organizationId },
    },
  ],
};
---
<Layout title="Brand Strategy, Content & Paid Advertising" description={content.settings.description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(searchMetadata)}/>
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        html[data-story-starting] [data-home-story] .home-story-panel {
          opacity: 0;
        }
      }
    </style>
    <script is:inline>
      document.documentElement.setAttribute('data-story-starting', '');
      // Keep the page readable if the animation script fails to load.
      window.addEventListener('load', () => {
        document.documentElement.removeAttribute('data-story-starting');
      }, { once: true });
    </script>
  </Fragment>
  <div class="home-story" data-home-story>
  <div class="home-story-track">
  <div class="home-story-panel">
  <section class="hero"><div class="container hero-grid">
    <div class="hero-copy"><h1>{content.home.title}</h1><p class="hero-description">{content.home.description}</p><div class="hero-actions"><a class="button" href={withBase('/book-call/')} data-track="strategy_call_click" data-location="hero">Book a {integrations.callDurationMinutes}-minute intro call <Arrow/></a><a class="text-link" href={withBase('/pricing/')}>Explore packages <Arrow/></a></div></div>
    <HeroArtwork/>
  </div></section>
  <div class="intro-strip"><div class="container"><span>Built around your business.</span><div><span>B2B & B2C</span><i></i><span>Focused projects</span><i></i><span>Ongoing support</span></div></div></div>
  </div>
  </div>

  <div class="home-story-track">
  <section class="section services-intro home-story-panel"><div class="container">
    <div class="section-heading"><div><p class="section-overline">Good thinking, put to work.</p><h2>Our services.</h2></div><p>Brand strategy, written content, paid campaigns, and CRM setup. Choose one service or combine them around the work you need.</p></div>
    <div class="service-rows">{content.packages.map((pkg) => <a class="service-row" href={withBase(`/services/#${pkg.id}`)}><span class="mono service-number">{pkg.number}</span><div><h3>{pkg.name}</h3><span>{serviceDetails[pkg.id].description}</span></div><p>{pkg.description}</p><span class="round-arrow"><Arrow/></span></a>)}</div>
  </div></section>
  </div>

  <div class="home-story-track">
  <section class="section work-section home-story-panel"><div class="container">
    <div class="section-heading"><div><h2>Explore sample work.</h2></div><div><p>See how positioning, content, and campaign decisions come together for fictional businesses.</p><a class="text-link" href={withBase('/work/')}>View all sample work <Arrow/></a></div></div>
    <WorkCards projects={content.projects.slice(0, 2)}/>
  </div></section>
  </div>

  <div class="home-story-track">
  <section class="section audience-section home-story-panel"><div class="container">
    <div class="audience-intro"><h2>Who we help.</h2><p>A different buying decision needs a different message. Our services support both B2B and B2C businesses.</p></div>
    <div class="audience-grid"><a href={withBase('/industries/b2b/')} class="audience-panel"><span class="mono">B2B businesses</span><h3>Make your<br/>expertise matter.</h3><p>Help business buyers understand your value, trust your thinking, and take the next step.</p><span class="text-link">Explore B2B <Arrow/></span></a><a href={withBase('/industries/b2c/')} class="audience-panel"><span class="mono">B2C businesses</span><h3>Give people<br/>a reason to choose.</h3><p>Connect your offer to an everyday need, with a clear story and a focused campaign.</p><span class="text-link">Explore B2C <Arrow/></span></a></div>
    <a class="text-link home-industry-link" href={withBase('/industries/')}>Explore all industries <Arrow/></a>
  </div></section>
  </div>

  <div class="home-story-track">
  <div class="home-story-panel home-story-pair">
  <section class="section process-section"><div class="container"><div class="section-heading"><div><p class="section-overline">From brief to launch.</p><h2>How we work.</h2></div><div><p>Agree what the work needs to do, who provides the inputs, and how it will be reviewed.</p><a class="text-link" href={withBase('/about/')}>The Mindlab approach<Arrow/></a></div></div><ol class="process-grid">{[
    ['Understand', 'Bring the offer, the audience, your priorities, and the materials you already have.'],
    ['Define', 'Agree deliverables, responsibilities, timing, and the review process in a written scope.'],
    ['Create & launch', 'Develop the work, collect your feedback, and prepare the approved deliverables.'],
    ['Review & improve', 'Review the work and available evidence, then agree what should happen next.'],
  ].map(([title, body], i) => <li><span class="process-number">0{i + 1}<span>↗</span></span><h3>{title}</h3><p>{body}</p></li>)}</ol></div></section>

  <section class="section border-top" id="packages"><div class="container cta-inner"><div><h2>Packages and pricing.</h2><p>Compare what’s included, see the fees, and find the right starting point for a focused project or ongoing support.</p></div><a class="button button-outline" href={withBase('/pricing/')}>Compare packages & pricing <Arrow/></a></div></section>

  </div>
  </div>

  <div class="home-story-track">
  <div class="home-story-panel home-story-pair">
  {content.guides.length > 0 && <section class="section tinted"><div class="container"><div class="section-heading"><div><h2>Practical marketing guides.</h2></div><div><p>Useful starting points for planning your next move.</p><a class="text-link" href={withBase('/thinking/')}>Read all guides <Arrow/></a></div></div><GuideList guides={content.guides.slice(0, 1)}/></div></section>}

  <section class="section"><div class="container faq-grid"><div><p class="section-overline">Before we begin.</p><h2>Common questions.</h2><a class="text-link" href={withBase('/pricing/')}>Scope, fees & more answers<Arrow/></a></div><FAQ items={content.faqs.filter((_, index) => [0, 2, 3].includes(index))}/></div></section>
  </div>
  </div>
  </div>
  <CTA/>
</Layout>

<script>
  const story = document.querySelector<HTMLElement>('[data-home-story]');
  if (story) {
    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
    const header = document.querySelector<HTMLElement>('.site-header');
    const artwork = story.querySelector<HTMLElement>('.hero-art');
    const foreground = artwork?.querySelector<HTMLElement>('.art-foreground');
    const cards = artwork?.querySelectorAll<HTMLElement>('.art-note, .art-stamp');
    const stack = [
      { x: -15, y: -12, turn: 23 },
      { x: 13, y: -5, turn: -24 },
      { x: -3, y: 14, turn: 17 },
      { x: 27, y: 22, turn: -24 },
    ];
    const partSelectors = [
      '.hero-description, .hero-actions, .hero-art',
      '.section-heading, .service-row',
      '.section-heading, .work-card',
      '.audience-intro, .audience-panel, .home-industry-link',
      '.section-heading, .process-grid, .cta-inner',
      '.section-heading, .guide-list, .faq-grid',
    ];
    const tracks = [...story.querySelectorAll<HTMLElement>('.home-story-track')].map((track, index) => ({
      track,
      panel: track.querySelector<HTMLElement>('.home-story-panel')!,
      parts: [...track.querySelectorAll<HTMLElement>(partSelectors[index])],
      visibleParts: [] as HTMLElement[],
      pinTop: 0,
      distance: 0,
      tall: false,
    }));
    for (const { parts } of tracks) {
      for (const part of parts) part.dataset.storyPart = '';
    }

    const headingParts = new Map<Element, ReturnType<typeof prepareHeading>>();
    const heroHeading = story.querySelector<HTMLElement>('.hero-copy h1');
    const opening = heroHeading ? prepareHeading(heroHeading) : undefined;
    for (const heading of story.querySelectorAll<HTMLElement>('.section-heading h2, .audience-intro h2, #packages h2, .faq-grid h2')) {
      const part = heading.closest('[data-story-part]');
      if (!part) continue;
      headingParts.set(part, prepareHeading(heading));
      part.setAttribute('data-story-heading-part', '');
      // Fade siblings along the heading's path so no ancestor dims the typed text.
      for (let child: Element = heading; child !== part; child = child.parentElement!) {
        for (const sibling of child.parentElement!.children) {
          if (sibling !== child) sibling.setAttribute('data-story-fade', '');
        }
      }
    }

    function prepareHeading(heading: HTMLElement) {
      const title = heading.textContent ?? '';
      const display = document.createElement('span');
      display.setAttribute('aria-hidden', 'true');
      const letters = Array.from(title, (letter) => {
        const glyph = document.createElement('span');
        glyph.textContent = letter;
        glyph.dataset.typeHidden = '';
        display.append(glyph);
        return glyph;
      });
      heading.setAttribute('aria-label', title);
      heading.replaceChildren(display);
      const letterDelay = 35;
      let elapsed = 0;
      const revealTimes = letters.map((_, index) => {
        elapsed += letterDelay * (letters[index - 1]?.textContent === '.' ? 4 : 1);
        return elapsed;
      });
      return {
        element: heading,
        letters,
        revealTimes,
        count: -1,
        cursor: undefined as HTMLElement | undefined,
        startedAt: undefined as number | undefined,
      };
    }

    function typeHeading(heading: ReturnType<typeof prepareHeading>, count: number) {
      const { letters, count: previous } = heading;
      if (previous === count) return;
      heading.cursor?.removeAttribute('data-type-cursor');
      for (let index = Math.max(0, Math.min(previous, count)); index < Math.max(previous, count); index++) {
        letters[index].toggleAttribute('data-type-hidden', index >= count);
      }
      heading.cursor = letters.slice(count).find((letter) => letter.textContent?.trim());
      heading.cursor?.setAttribute('data-type-cursor', '');
      if (count === letters.length) letters.at(-1)?.setAttribute('data-type-finished', '');
      heading.count = count;
    }

    let frame = 0;
    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    const playHeading = (heading: ReturnType<typeof prepareHeading>, now: number) => {
      heading.startedAt ??= now;
      const elapsed = now - heading.startedAt;
      const nextLetter = heading.revealTimes.findIndex((time) => time > elapsed);
      typeHeading(heading, nextLetter < 0 ? heading.letters.length : nextLetter);
      if (nextLetter >= 0) schedule();
    };

    const render = () => {
      frame = 0;
      if (!motion.matches) return;
      const now = performance.now();
      if (opening && opening.count < opening.letters.length) playHeading(opening, now);
      const viewport = window.innerHeight;
      tracks.forEach(({ track, visibleParts, pinTop, distance, tall }, trackIndex) => {
        const top = track.getBoundingClientRect().top;
        const progress = clamp((pinTop - top) / distance);
        let fullyRevealed = true;
        visibleParts.forEach((part, partIndex) => {
          let opacity: number;
          if (!tall) {
            // Advance through the parts using only the distance scrolled.
            opacity = clamp((progress * (visibleParts.length + 0.5) - partIndex) / 1.5);
          } else {
            // Read tall panels in normal flow, then finish the fade while their bottom stays pinned.
            const start = viewport * 0.95 - partIndex * 36;
            const revealTravel = progress * (viewport * 0.5 + (visibleParts.length - 1) * 36);
            const revealedDistance = start - part.getBoundingClientRect().top + revealTravel;
            opacity = clamp(revealedDistance / (viewport * 0.35));
          }
          if (trackIndex === 0) opacity = Math.min(opacity, clamp(window.scrollY / 160));
          fullyRevealed &&= opacity >= 1;
          part.style.setProperty('--story-opacity', opacity.toFixed(3));
          const heading = headingParts.get(part);
          if (heading && heading.count < heading.letters.length) {
            const bounds = heading.element.getBoundingClientRect();
            if (heading.startedAt !== undefined || (opacity >= 0.2 && bounds.top < viewport && bounds.bottom > 0)) {
              playHeading(heading, now);
            }
          }
          if (part === artwork) {
            const spread = clamp((opacity - 0.15) / 0.85);
            artwork.style.setProperty('--stack-amount', String(1 - spread * spread * (3 - 2 * spread)));
          }
        });
        if (trackIndex === 0) {
          const wasComplete = story.hasAttribute('data-hero-reveal-complete');
          // Use separate thresholds to absorb small trackpad movements at the boundary.
          const isComplete = wasComplete ? progress > 1 - 32 / distance : progress >= 1 && fullyRevealed;
          if (wasComplete !== isComplete) {
            story.toggleAttribute('data-hero-reveal-complete', isComplete);
            story.dispatchEvent(new Event('hero-reveal-change'));
          }
        }
      });
    };

    const schedule = () => {
      if (!frame) frame = window.requestAnimationFrame(render);
    };
    const measure = () => {
      const viewport = window.innerHeight;
      const showCards = Boolean(foreground?.getClientRects().length);
      const headerHeight = header
        ? Number.parseFloat(getComputedStyle(header).getPropertyValue('--header-compact-height')) || 60
        : 0;
      tracks.forEach((entry, index) => {
        const panelHeight = entry.panel.offsetHeight;
        const clearance = index === 0 ? header?.offsetHeight ?? headerHeight : headerHeight;
        entry.tall = panelHeight > viewport - clearance;
        entry.pinTop = entry.tall ? viewport - panelHeight : (viewport + clearance - panelHeight) / 2;
        entry.distance = motion.matches
          ? Math.round(Math.max(300, Math.min(460, viewport * 0.5)))
          : 0;
        entry.visibleParts = entry.parts.filter((part) => part.getClientRects().length > 0);
        entry.track.style.setProperty('--story-distance', `${entry.distance}px`);
        entry.track.style.setProperty('--story-pin-top', `${entry.pinTop}px`);
        entry.track.toggleAttribute('data-story-pinned', entry.distance > 0);
      });
      if (showCards && artwork?.offsetWidth) {
        cards?.forEach((card, index) => {
          const offset = stack[index];
          const x = (artwork.offsetWidth - card.offsetWidth) / 2 - card.offsetLeft + offset.x;
          const y = (artwork.offsetHeight - card.offsetHeight) / 2 - card.offsetTop + offset.y;
          card.style.setProperty('--stack-x', `${x}px`);
          card.style.setProperty('--stack-y', `${y}px`);
          card.style.setProperty('--stack-turn', `${offset.turn}deg`);
        });
      }
      if (frame) window.cancelAnimationFrame(frame);
      render();
    };

    const resize = new ResizeObserver(measure);
    for (const { panel } of tracks) resize.observe(panel);
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', measure);
    window.addEventListener('pageshow', measure);
    motion.addEventListener('change', measure);
    measure();
    document.documentElement.removeAttribute('data-story-starting');
  }
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .home-story-track[data-story-pinned]::after {
      content: '';
      display: block;
      height: var(--story-distance);
    }

    .home-story-track[data-story-pinned] > .home-story-panel {
      position: sticky;
      top: var(--story-pin-top);
    }

    .home-story-pair > .section {
      padding-block: 48px;
    }

    [data-story-part]:not([data-story-heading-part]),
    [data-story-fade] {
      opacity: var(--story-opacity, 1);
    }

    [data-type-hidden] {
      color: transparent;
    }

    [data-type-cursor],
    [data-type-finished] {
      position: relative;
    }

    [data-type-cursor]::before {
      content: '_';
      position: absolute;
      inset-inline-start: 0;
      color: var(--violet);
    }

    [data-type-finished]::after {
      content: '_';
      position: absolute;
      inset-inline-start: 100%;
      color: var(--violet);
      animation: heading-cursor-blink 1s step-end 2 forwards;
    }

    @keyframes heading-cursor-blink {
      0% { opacity: 1; }
      50%, 100% { opacity: 0; }
    }

    [data-story-part]:focus-within [data-type-hidden] {
      color: inherit;
    }

    [data-story-part]:focus-within [data-type-cursor]::before {
      content: none;
    }

    .hero-art :is(.art-note, .art-stamp) {
      translate: calc(var(--stack-x, 0px) * var(--stack-amount, 0))
                 calc(var(--stack-y, 0px) * var(--stack-amount, 0));
      rotate: calc(var(--stack-turn, 0deg) * var(--stack-amount, 0));
    }

    [data-story-part]:focus-within,
    [data-story-part]:target,
    [data-story-heading-part]:focus-within [data-story-fade],
    [data-story-heading-part]:target [data-story-fade] {
      opacity: 1;
    }
  }
</style>
