---
import { withBase } from '@/lib/urls';
import Layout from '@/layouts/Layout.astro';
import Arrow from '@/components/Arrow.astro';
---
<Layout title="Page not found" description="Find your way back to Mindlab's services and packages." noindex><section class="page-hero container not-found"><p class="eyebrow context-label">404</p><h1>Page not found.</h1><p class="lede">That page isn’t here. Our services are a good place to start.</p><a class="button" href={withBase("/")}>Back to Mindlab <Arrow/></a></section></Layout>
