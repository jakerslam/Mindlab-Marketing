---
import { withBase } from '@/lib/urls';
import Layout from '@/layouts/Layout.astro';
import Arrow from '@/components/Arrow.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { getContent } from '@/content';
const { packages, faqs } = await getContent();
---
<Layout title="Brand strategy, content & paid campaigns" description="Explore Brand Blueprint, Content Studio, and Demand Campaigns. Understand the deliverables, scope, and working rhythm for each service.">
  <section class="page-hero container"><p class="eyebrow">Our services</p><h1>A clear plan.<br/>The right kind of support.</h1><p class="lede">Start with the piece you need. Connect the others when it makes sense. Brand strategy, content, and paid campaigns—with the scope spelled out.</p><div class="anchor-nav">{packages.map((pkg) => <a href={`#${pkg.id}`}>{pkg.name}<span>↘</span></a>)}<a href={withBase("/pricing/")}>Compare prices<Arrow/></a></div></section>
  {packages.map((pkg) => <section class="section service-detail" id={pkg.id}><div class="container detail-grid"><div><p class="eyebrow">{pkg.number} / {pkg.cadence === 'project' ? 'The foundation' : pkg.id === 'content-studio' ? 'The story' : 'The connection'}</p><h2>{pkg.name}</h2><p class="detail-tagline">{pkg.tagline}</p><p>{pkg.description}</p><a class="button" href={withBase(`/book-call/?service=${pkg.id}`)} data-track="package_interest" data-service={pkg.id}>Let’s talk about {pkg.name.split(' ')[0].toLowerCase()} <Arrow/></a><p><a class="text-link" href={withBase(`/pricing/#${pkg.id}`)}>View package pricing <Arrow/></a></p></div><div class="detail-scope"><h3>What’s included</h3><ul class="check-list">{pkg.deliverables.map((item) => <li>{item}</li>)}</ul><div class="scope-exclusions"><h4>Separately scoped</h4><p>{pkg.exclusions.join(' · ')}</p></div><div class="scope-meta"><div><h4>A good fit for</h4><p>{pkg.idealFor}</p></div><div><h4>The working rhythm</h4><p>{pkg.timeline}</p></div></div></div></div></section>)}
  <section class="section tinted" id="packages"><div class="container cta-inner"><div><p class="eyebrow">Packages & pricing</p><h2>Find your starting point.</h2><p>Compare service fees, setup costs, and what’s included. Build a first-month estimate with advertising spend shown separately.</p></div><a class="button" href={withBase("/pricing/")}>Compare packages & pricing <Arrow/></a></div></section>
  <section class="section border-top"><div class="container faq-grid"><div><p class="eyebrow">Before we begin</p><h2>Questions,<br/>answered.</h2><p>Final scope, prices, and terms are confirmed in your written agreement.</p></div><FAQ items={faqs}/></div></section><CTA/>
</Layout>
