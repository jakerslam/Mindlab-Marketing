---
import { withBase } from '@/lib/urls';
import Layout from '@/layouts/Layout.astro';
import Arrow from '@/components/Arrow.astro';
import PackageCards from '@/components/PackageCards.astro';
import PackagePlanner from '@/components/PackagePlanner';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { getContent } from '@/content';
import { formatPrice } from '@/domain/content';
const { packages, faqs } = await getContent();
const retainers = packages.filter((pkg) => pkg.cadence === 'month');
const combinedPrice = retainers.reduce((total, pkg) => total + pkg.price, 0);
const combinedSetup = retainers.reduce((total, pkg) => total + pkg.setup, 0);
const plannerPackages = packages.map(({ id, name, price, setup, cadence }) => ({ id, name, price, setup, cadence }));
---
<Layout title="Services & transparent package pricing" description="Explore Brand Blueprint, Content Studio, and Demand Campaigns. Clear deliverables, project and monthly pricing, setup fees, and exclusions.">
  <section class="page-hero container"><p class="eyebrow">Our services & packages</p><h1>A clear plan.<br/>The right kind of support.</h1><p class="lede">Start with the piece you need. Connect the others when it makes sense. Brand strategy, content, and paid campaigns—with the scope spelled out.</p><div class="anchor-nav">{packages.map((pkg) => <a href={`#${pkg.id}`}>{pkg.name}<span>↘</span></a>)}<a href="#packages">Compare prices<span>↘</span></a></div></section>
  {packages.map((pkg) => <section class="section service-detail" id={pkg.id}><div class="container detail-grid"><div><p class="eyebrow">{pkg.number} / {pkg.cadence === 'project' ? 'The foundation' : pkg.id === 'content-studio' ? 'The story' : 'The connection'}</p><h2>{pkg.name}</h2><p class="detail-tagline">{pkg.tagline}</p><p>{pkg.description}</p><div class="detail-price">{formatPrice(pkg.price)}<span> / {pkg.cadence}</span></div><p class="setup-line">{pkg.setup ? `+ ${formatPrice(pkg.setup)} one-time ${pkg.id === 'content-studio' ? 'onboarding' : 'launch'}` : 'No additional setup fee.'}{pkg.id === 'demand-campaigns' && <><br/>Media budget is additional.</>}</p><a class="button" href={withBase(`/book-call/?service=${pkg.id}`)} data-track="package_interest" data-service={pkg.id}>Let’s talk about {pkg.name.split(' ')[0].toLowerCase()} <Arrow/></a></div><div class="detail-scope"><h3>What’s included</h3><ul class="check-list">{pkg.deliverables.map((item) => <li>{item}</li>)}</ul><div class="scope-exclusions"><h4>Separately scoped</h4><p>{pkg.exclusions.join(' · ')}</p></div><div class="scope-meta"><div><h4>A good fit for</h4><p>{pkg.idealFor}</p></div><div><h4>The working rhythm</h4><p>{pkg.timeline}</p></div></div></div></div></section>)}
  <section class="section tinted" id="packages"><div class="container"><div class="section-heading"><div><p class="eyebrow">Compare your options</p><h2>Know what<br/>you’re starting with.</h2></div><p>Clear fees and clear boundaries. These starting packages keep planning and delivery focused.</p></div><PackageCards packages={packages} detailed/><div class="combined-package"><div><p class="eyebrow">Better connected, when you need both</p><h3>Content and Campaigns</h3><p>The full Content Studio and Demand Campaigns scopes, with one coordinated monthly review. Brand Blueprint stays a separate project if you need it.</p></div><div><p class="combined-price">{formatPrice(combinedPrice)}<span> / month</span></p><p>+ {formatPrice(combinedSetup)} combined setup. Media additional.</p><a class="text-link" href={withBase("/book-call/?service=combined")} data-track="package_interest" data-service="combined">Discuss the combined option <Arrow/></a></div></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Put the numbers together</p><h2>A clearer view<br/>of the cost.</h2></div><p>Separate the service fee, setup, and advertising budget. Use this guide to understand a possible first month.</p></div><PackagePlanner packages={plannerPackages} client:visible/><noscript><p>JavaScript enables the interactive estimate. All service prices, setup fees, and exclusions are listed above.</p></noscript></div></section>
  <section class="section border-top"><div class="container faq-grid"><div><p class="eyebrow">Before we begin</p><h2>Questions,<br/>answered.</h2><p>Final scope, prices, and terms are confirmed in your written agreement.</p></div><FAQ items={faqs}/></div></section><CTA/>
</Layout>
