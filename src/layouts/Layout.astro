---
import { withBase } from '@/lib/urls';
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '@/styles/global.css';
import '@/styles/editorial.css';
import '@/styles/navigation-pricing.css';
import '@/styles/audiences.css';
import '@/styles/refinements.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Analytics from '@/components/Analytics.astro';
import { integrations } from '@/integrations/config';
interface Props { title: string; description: string; noindex?: boolean; canonicalPath?: string }
const { title, description, noindex = false, canonicalPath } = Astro.props;
const canonical = new URL(canonicalPath ? withBase(canonicalPath) : Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase('/images/mindlab-share.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#F7F7F4"/>
    <title>{title} | Mindlab Solutions</title>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")}/>
    <meta property="og:title" content={`${title} | Mindlab Solutions`}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={socialImage}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Mindlab Solutions. Brand strategy, content, and campaigns."/>
    <meta name="twitter:card" content="summary_large_image"/>
    {(noindex || integrations.stage !== 'production') && <meta name="robots" content="noindex, nofollow"/>}
    <slot name="head"/>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header/>
    <main id="main"><slot/></main>
    <Footer/>
    <Analytics/>
  </body>
</html>
