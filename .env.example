# Explicit preview source. Never falls back from Sanity to local content.
CONTENT_SOURCE=local
SITE_STAGE=preview
SITE_URL=https://mindlab.solutions

# Switch CONTENT_SOURCE to sanity after importing and publishing the documents.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Same public values for the separate browser editor build.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Used only by the manual content import script. Never exposed to the browser.
SANITY_WRITE_TOKEN=

# Public destinations, not secrets. Empty destinations render an honest unavailable state.
PUBLIC_TALLY_FORM_ID=
PUBLIC_BOOKING_URL=
PUBLIC_CALL_DURATION_MINUTES=30
PUBLIC_CONTACT_EMAIL=
# Optional. Loads only after the visitor opts into analytics.
PUBLIC_GTM_ID=

# Production gate: set only after the owner reviews pricing, copy, privacy, and samples.
LAUNCH_CONTENT_APPROVED=false
